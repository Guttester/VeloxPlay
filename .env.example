# Copy to .env in the backend directory (Java .properties syntax, no quotes).
# Spring reads .env automatically when launched from this directory.
# Environment variables override values from this file.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/veloxplay
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
SITE_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_LIMIT=20
AUTH_REGISTER_LIMIT=5
AUTH_REFRESH_LIMIT=60
# Empty locally. Only list the exact proxies/networks you control in production.
TRUSTED_PROXY_CIDRS=
JWT_SECRET=REPLACE_WITH_A_RANDOM_PRIVATE_KEY_OF_AT_LEAST_32_BYTES

# Optional private owner. Never show these credentials in the frontend or commit them.
ADMIN_EMAIL=REPLACE_WITH_YOUR_PRIVATE_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_A_PRIVATE_PASSWORD_OF_12_TO_72_CHARACTERS

APP_SEED_ENABLED=true
SEED_MODERATOR_EMAIL=moderador@veloxplay.com
SEED_MODERATOR_PASSWORD=Moderador@123
SEED_DEMO_EMAIL=demo@veloxplay.com
SEED_DEMO_PASSWORD=Demo@123
DEMO_TTL_MINUTES=60
DEMO_CLEANUP_ENABLED=true
DEMO_CLEANUP_DELAY_MS=600000
